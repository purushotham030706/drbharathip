# Database: use a dedicated development database; never commit server/.env.
MONGODB_URI=mongodb://127.0.0.1:27017/dr-bharathi-appointment-dev

# Session and CSRF secrets: generate unique long random values for each environment.
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_COOKIE_NAME=sid
CSRF_SECRET=replace-with-a-long-random-csrf-secret

# Server
PORT=4000
NODE_ENV=development
# Production must be https://www.<your-domain>, sharing the parent domain with api.<your-domain>.
CLIENT_ORIGIN=http://localhost:5173

# Email: configure later; no real key belongs in this file.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-email-provider-key
EMAIL_FROM="Dr. Bharathi P Clinic <no-reply@example.invalid>"

# Login protection
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=5
